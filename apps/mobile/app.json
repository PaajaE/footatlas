{
  "expo": {
    "name": "FootAtlas",
    "slug": "footatlas",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cz.footatlas.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "FootAtlas čte vaše kroky a ušlou vzdálenost, aby z nich sestavil vaši kroniku pohybu. Data zůstávají na telefonu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cz.footatlas.app",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ],
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "FootAtlas čte vaše kroky a ušlou vzdálenost, aby z nich sestavil vaši kroniku pohybu. Data zůstávají na telefonu.",
          "NSHealthUpdateUsageDescription": "FootAtlas do zdravotních dat nic nezapisuje.",
          "background": false
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "@maplibre/maplibre-react-native",
      "expo-sqlite",
      "./plugins/withReleaseSigning",
      "expo-asset"
    ],
    "scheme": "footatlas",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://footatlas-api.ecerpavel.workers.dev"
    }
  }
}
